{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/auto-approve-worktrees.js",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/check-cron-results.sh",
            "statusMessage": "Checking background audit results..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/check-test-audit.sh",
            "statusMessage": "Checking test audit status..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/check-eval-audit.sh",
            "statusMessage": "Checking eval audit status..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/error-tracker.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/error-tracker.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/usage-tracker.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
