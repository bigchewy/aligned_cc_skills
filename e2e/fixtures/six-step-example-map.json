{
  "version": 1,
  "person": "Maya",
  "goal": {
    "text": "80% in-office attendance by end of Q2, up from 40%"
  },
  "items": {
    "o1": {
      "kind": "obstacle",
      "text": "People don't want to commute",
      "star": false,
      "parent": "goal",
      "order": 1
    },
    "o7": {
      "kind": "obstacle",
      "text": "The commute got longer for people who moved",
      "star": false,
      "parent": "o1",
      "order": 1
    },
    "s6": {
      "kind": "solution",
      "text": "Let people who moved start later on office days",
      "star": false,
      "parent": "o7",
      "order": 1
    },
    "o8": {
      "kind": "obstacle",
      "text": "The value of being in the office hasn't kept up",
      "star": false,
      "parent": "o1",
      "order": 2
    },
    "o9": {
      "kind": "obstacle",
      "text": "We haven't defined what the office is for",
      "star": false,
      "parent": "o8",
      "order": 1
    },
    "s1": {
      "kind": "solution",
      "text": "Define the purpose of in-office time and communicate it",
      "star": true,
      "parent": "o9",
      "order": 1
    },
    "o10": {
      "kind": "obstacle",
      "text": "An office day looks just like a day at home",
      "star": false,
      "parent": "o8",
      "order": 2
    },
    "s2": {
      "kind": "solution",
      "text": "Redesign the office to support that purpose",
      "star": false,
      "parent": "o10",
      "order": 1
    },
    "s3": {
      "kind": "solution",
      "text": "Create in-person-only experiences",
      "star": true,
      "parent": "o8",
      "order": 3
    },
    "o13": {
      "kind": "obstacle",
      "text": "Teams have no budget for getting together",
      "star": false,
      "parent": "s3",
      "order": 1
    },
    "s7": {
      "kind": "solution",
      "text": "Set aside a small budget for each team's office days",
      "star": false,
      "parent": "o13",
      "order": 1
    },
    "s11": {
      "kind": "solution",
      "text": "Start with one in-person session a month for each team",
      "star": false,
      "parent": "s3",
      "order": 2
    },
    "o2": {
      "kind": "obstacle",
      "text": "The office is too noisy",
      "star": false,
      "parent": "goal",
      "order": 2
    },
    "s8": {
      "kind": "solution",
      "text": "Add quiet rooms on each floor",
      "star": false,
      "parent": "o2",
      "order": 1
    },
    "o3": {
      "kind": "obstacle",
      "text": "Some managers aren't enforcing the policy",
      "star": false,
      "parent": "goal",
      "order": 3
    },
    "s4": {
      "kind": "solution",
      "text": "Set clear expectations with managers",
      "star": false,
      "parent": "o3",
      "order": 1
    },
    "o4": {
      "kind": "obstacle",
      "text": "Expectations are unclear",
      "star": false,
      "parent": "goal",
      "order": 4
    },
    "s9": {
      "kind": "solution",
      "text": "Publish which days each team is in",
      "star": false,
      "parent": "o4",
      "order": 1
    },
    "o5": {
      "kind": "obstacle",
      "text": "No reason to come in, since meetings are still remote",
      "star": false,
      "parent": "goal",
      "order": 5
    },
    "o11": {
      "kind": "obstacle",
      "text": "Nothing we do needs people in the same room",
      "star": false,
      "parent": "o5",
      "order": 1
    },
    "o12": {
      "kind": "obstacle",
      "text": "We have no in-person-only meetings",
      "star": false,
      "parent": "o11",
      "order": 1
    },
    "s10": {
      "kind": "solution",
      "text": "Move each team's planning meeting to an office day",
      "star": false,
      "parent": "o12",
      "order": 1
    },
    "o6": {
      "kind": "obstacle",
      "text": "Some people feel less productive in the office",
      "star": false,
      "parent": "goal",
      "order": 6
    },
    "s5": {
      "kind": "solution",
      "text": "Run a monthly pulse survey",
      "star": false,
      "parent": "o6",
      "order": 1
    }
  },
