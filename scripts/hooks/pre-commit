#!/bin/bash
# Two jobs, neither of which ever blocks a commit:
#
# 1. Rebuild the org chart pages when a commit stages their inputs, and stage
#    the rebuilt pages.
# 2. Bump the plugin's patch version whenever a commit touches shipped plugin
#    content, so the change actually reaches the Claude Code plugin cache.
#
# Claude Code re-copies this repo into ~/.claude/plugins/cache only when the
# version string changes. Edit a skill, commit without bumping, and the running
# plugin keeps serving the old file with no error anywhere.
#
# Installed via: git config core.hooksPath scripts/hooks
# Skip for one commit with: git commit --no-verify

set -e

REPO_ROOT=${REPO_ROOT:-$(git rev-parse --show-toplevel)}

# Rebuild the org chart pages. Warns and returns 0 on any problem.
#
# Python is picked in this order: this checkout's e2e/.venv, the main
# checkout's e2e/.venv (a git worktree has no venv of its own), then python3.
# A candidate is used only if it has PyYAML and can parse the generator, so an
# old system python3 is skipped instead of failing on newer syntax.
rebuild_org_chart() {
  local generator="$REPO_ROOT/scripts/generate-org-chart.py"
  local main_venv=""
  local common
  if common=$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    main_venv="${common%/*}/e2e/.venv/bin/python"
  fi

  local py=""
  local candidate
  for candidate in "$REPO_ROOT/e2e/.venv/bin/python" $main_venv python3; do
    if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c 'import ast, sys, yaml; ast.parse(open(sys.argv[1]).read())' "$generator" >/dev/null 2>&1; then
      py="$candidate"
      break
    fi
  done

  if [ -z "$py" ]; then
    echo "[pre-commit] no python with PyYAML that can run scripts/generate-org-chart.py; org chart NOT rebuilt"
    return 0
  fi

  if ! OUT=$("$py" "$generator" 2>&1); then
    echo "[pre-commit] org chart build failed; org chart NOT rebuilt:"
    echo "$OUT"
    return 0
  fi

  if ! OUT=$(git add "$REPO_ROOT/skills/org-chart/pages" 2>&1); then
    echo "[pre-commit] org chart pages rebuilt but NOT staged:"
    echo "$OUT"
    return 0
  fi
  echo "[pre-commit] Org chart pages rebuilt"
  return 0
}

# Do nothing more when this file is sourced (the tests source it to call
# rebuild_org_chart on its own).
if [ "${BASH_SOURCE[0]}" != "$0" ]; then
  return 0
fi

ORG_CHART_INPUTS=$(git diff --cached --name-only --diff-filter=ACMR \
  -- advisors/registry.yaml frameworks/registry.yaml skills/org-chart/seats.yaml \
  scripts/org-chart-templates 2>/dev/null || true)

if [ -n "$ORG_CHART_INPUTS" ] && [ -f "$REPO_ROOT/scripts/generate-org-chart.py" ]; then
  rebuild_org_chart
fi

# Only bump for directories that ship inside the plugin. Commits that touch
# only docs, todo.md, or the top-level readmes leave the version alone.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR \
  -- advisors frameworks skills agents hooks tools .claude-plugin 2>/dev/null || true)

[ -z "$STAGED" ] && exit 0

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] node not on PATH; plugin version NOT bumped, this commit will not reach the plugin cache"
  exit 0
fi

if ! NEXT=$(node "$REPO_ROOT/scripts/bump-plugin-version.cjs" 2>&1); then
  echo "[pre-commit] version bump failed, this commit will not reach the plugin cache:"
  echo "$NEXT"
  exit 0
fi

git add "$REPO_ROOT/.claude-plugin/plugin.json" "$REPO_ROOT/.claude-plugin/marketplace.json"

echo "[pre-commit] Plugin version bumped to $NEXT"
